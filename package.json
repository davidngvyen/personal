{
  "name": "daily-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Daily AI Assistant - strict local to-do and calendar with accountability popups",
  "main": "dist/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:renderer\"",
    "dev:main": "ts-node --transpile-only main/main.ts",
    "dev:renderer": "vite --config renderer/vite.config.ts",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p main/tsconfig.json",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "lint": "eslint .",
    "start": "electron ./dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "electron": "^30.0.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.36.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.3",
    "@vitejs/plugin-react": "^4.3.1"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.1",
    "csv-parse": "^5.5.6",
    "date-fns": "^3.6.0",
    "electron-updater": "^6.2.1",
    "electron-store": "^8.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "react-big-calendar": "^1.11.5",
    "moment": "^2.30.1"
  }
}
